
workspace_layout tabbed

bindsym $mod+$left focus left
bindsym $mod+$down focus down
bindsym $mod+$up focus up
bindsym $mod+$right focus right

bindsym $mod+Shift+$left move left
bindsym $mod+Shift+$down move down
bindsym $mod+Shift+$up move up
bindsym $mod+Shift+$right move right
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# Drag floating windows by holding down $mod and left mouse button.
# Resize them with right mouse button + $mod.
# Despite the name, also works for non-floating windows.
# Change normal to inverse to use left mouse button for resizing and right
# mouse button for dragging.
floating_modifier $mod normal

focus_follows_mouse yes

workspace 11 output $o1
workspace 12 output $o1
workspace 13 output $o1
workspace 14 output $o1
workspace 15 output $o1
workspace 16 output $o1
workspace 17 output $o1

#workspace 21 layout tabbed
#workspace 4z layout tabbed

bindsym --to-code {
    $mod+1  workspace 11
    $mod+z  workspace 11
    $mod+2  workspace 12
    $mod+x  workspace 12
    $mod+3  workspace 13
    $mod+c  workspace 13
    $mod+4  workspace 14
    $mod+v  workspace 14
    $mod+5  workspace 15
    $mod+6  workspace 16
    $mod+7  workspace 17


    $mod+Shift+1  move container to workspace 11  
    $mod+Shift+2  move container to workspace 12  
    $mod+Shift+3  move container to workspace 13  
    $mod+Shift+4  move container to workspace 14  
    $mod+Shift+5  move container to workspace 15  
    $mod+Shift+6  move container to workspace 16
    $mod+Shift+7  move container to workspace 17
}

workspace 21 output $o2
workspace 22 output $o2
workspace 23 output $o2
workspace 24 output $o2
workspace 25 output $o2
workspace 26 output $o2
workspace 27 output $o2

bindsym --to-code {
    # focus HDMI workspaces
    $mod+Ctrl+1 workspace 21
    $mod+Ctrl+z workspace 21
    $mod+Ctrl+2 workspace 22
    $mod+Ctrl+x workspace 22
    $mod+Ctrl+3 workspace 23
    $mod+Ctrl+c workspace 23
    $mod+Ctrl+4 workspace 24
    $mod+Ctrl+v workspace 24
    $mod+Ctrl+5 workspace 25
    $mod+Ctrl+6 workspace 26
    $mod+Ctrl+7 workspace 27

    # move container to HDMI
    $mod+Ctrl+Shift+1 move container to workspace 21
    $mod+Ctrl+Shift+2 move container to workspace 22
    $mod+Ctrl+Shift+3 move container to workspace 23
    $mod+Ctrl+Shift+4 move container to workspace 24
    $mod+Ctrl+Shift+5 move container to workspace 25
    $mod+Ctrl+Shift+6 move container to workspace 26
    $mod+Ctrl+Shift+7 move container to workspace 27
}

bindsym $mod+N workspace next_on_output
bindsym $mod+P  workspace prev_on_output
